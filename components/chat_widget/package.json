{
  "name": "open-chat-studio-widget",
  "version": "0.13.1",
  "description": "Chat component for Open Chat Studio",
  "packageManager": "pnpm@10.30.1",
  "exports": "./dist/esm/open-chat-studio-widget.js",
  "unpkg": "dist/open-chat-studio-widget/open-chat-studio-widget.esm.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimagi/open-chat-studio.git"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "stencil-test",
    "test:security": "node --test src/utils/markdown-security.test.mjs",
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "generate": "stencil generate",
    "use:npmReadme": "mv 'README.md' 'git.README.md' && cp 'src/components/ocs-chat/readme.md' 'README.md'",
    "use:gitReadme": "mv 'git.README.md' 'README.md'",
    "prepublishOnly": "pnpm run build && pnpm run use:npmReadme",
    "postpublish": "pnpm run use:gitReadme",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@stencil/core": "5.0.0-beta.27",
    "dompurify": "^3.0.5",
    "js-cookie": "^3.0.5",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@stencil/vitest": "^1.16.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^26.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
