## AWS access for S3 (public media storage and whatsapp voice reply file storage)
# These don't need to be provided if you are using AWS IAM Roles to provide access for your application
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=
WHATSAPP_S3_AUDIO_BUCKET=

## Public media storage (e.g. user uploads)
# This will use the same AWS credentials as above
USE_S3_STORAGE=False
AWS_PUBLIC_STORAGE_BUCKET_NAME=
AWS_PRIVATE_STORAGE_BUCKET_NAME=

## Optional: S3-compatible storage (MinIO, Cloudflare R2, Backblaze B2, etc.)
## Leave all blank for AWS S3 (default). When set, they apply to media storage AND WhatsApp audio.
## See docs/hosting/configuration.md for provider-specific examples.
# AWS_S3_ENDPOINT_URL=https://minio.example.com          # no trailing slash; omit for AWS S3
# AWS_S3_ADDRESSING_STYLE=path                           # path (MinIO, IP endpoints) | virtual (most cloud providers) | unset = auto
# AWS_S3_CUSTOM_DOMAIN=minio.example.com/public-bucket   # public-media URL prefix exactly as a browser sees it
# For path-style endpoints (e.g. MinIO), include the bucket here (host/bucket): the bucket is part of
# the public URL path. For virtual-host/CDN, set the host only. AWS_*_STORAGE_BUCKET_NAME is used
# separately for API operations.

## Optional Task Badger integration (celery task monitoring)
TASKBADGER_ORG=
TASKBADGER_PROJECT=
TASKBADGER_API_KEY=

## Production Email Config (Uncomment the one you are using)
ACCOUNT_EMAIL_VERIFICATION=mandatory

